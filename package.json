{
  "name": "66quantstudio",
  "private": true,
  "version": "0.1.0",
  "description": "QuantStudio workbench for Simon Wu — Mosha glass web UI over the QuantSkills library snapshot.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix apps/web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "QS_ALLOW_DEV_ORIGINS=1 node server/index.mjs",
    "dev": "QS_ALLOW_DEV_ORIGINS=1 concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build --prefix apps/web",
    "start": "node server/index.mjs",
    "test": "node --test server/tests/*.test.mjs",
    "verify": "npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
